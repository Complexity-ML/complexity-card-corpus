{
  "format": "scenario-family-pack-v1",
  "tankId": "critique_revision",
  "families": [
    {
      "id": "critique_revision",
      "label": "Critique and revision",
      "target": 6000,
      "domains": [
        {
          "id": "email_draft",
          "label": "Email draft",
          "subject": "a draft email",
          "context": "The text has a clear purpose but may contain unnecessary friction or ambiguity."
        },
        {
          "id": "argument",
          "label": "Argument",
          "subject": "a short written argument",
          "context": "The central claim, evidence, assumptions, and counterpoint can be inspected separately."
        },
        {
          "id": "project_plan",
          "label": "Project plan",
          "subject": "a small project plan",
          "context": "The plan lists an objective, tasks, dependencies, owners, and completion criteria."
        },
        {
          "id": "explanation",
          "label": "Explanation",
          "subject": "a draft explanation",
          "context": "The explanation may be accurate while still hiding a key reasoning step from the reader."
        },
        {
          "id": "instructions",
          "label": "Instructions",
          "subject": "a set of user instructions",
          "context": "Order, prerequisites, warnings, and verification steps determine whether the instructions are usable."
        },
        {
          "id": "summary",
          "label": "Summary",
          "subject": "a draft summary",
          "context": "The summary must preserve the source emphasis without carrying unnecessary detail."
        },
        {
          "id": "claim_evidence",
          "label": "Claim and evidence note",
          "subject": "a claim-and-evidence note",
          "context": "Each claim should have proportionate support and unsupported interpretation must remain visible."
        },
        {
          "id": "interface_copy",
          "label": "Interface copy",
          "subject": "a short interface message",
          "context": "The text must orient the user, state the consequence, and offer a clear next action."
        },
        {
          "id": "status_update",
          "label": "Status update",
          "subject": "a project status update",
          "context": "Progress, blockers, dates, and confidence must use mutually consistent language."
        },
        {
          "id": "survey_report",
          "label": "Survey report",
          "subject": "a short survey report",
          "context": "Sample size, observed responses, and population-level claims require proportionate wording."
        },
        {
          "id": "policy_notice",
          "label": "Policy notice",
          "subject": "a draft policy notice",
          "context": "The operative rule, exception path, authority, and effective timing must be usable."
        },
        {
          "id": "data_caption",
          "label": "Data caption",
          "subject": "a figure or table caption",
          "context": "The metric, comparison, scope, and uncertainty must be visible without overstating the figure."
        },
        {
          "id": "release_note",
          "label": "Release note",
          "subject": "a software release note draft",
          "context": "Fixed issues, remaining limits, and compatibility claims require bounded wording."
        },
        {
          "id": "support_macro",
          "label": "Support reply template",
          "subject": "a support reply template",
          "context": "The response must distinguish a proposed check from a verified resolution."
        },
        {
          "id": "risk_assessment",
          "label": "Risk assessment",
          "subject": "a short risk assessment",
          "context": "Likelihood, impact, evidence, and mitigation must remain separate and reviewable."
        },
        {
          "id": "data_memo",
          "label": "Data memo",
          "subject": "a short data-analysis memo",
          "context": "Question, method, result, uncertainty, and recommendation must form a traceable argument."
        },
        {
          "id": "landing_page",
          "label": "Landing page",
          "subject": "a product landing page",
          "context": "Audience, promise, evidence, action, and qualification must remain aligned without exaggerated claims."
        },
        {
          "id": "lesson_plan",
          "label": "Lesson plan",
          "subject": "a lesson plan",
          "context": "Learning objective, activity, prerequisite, assessment, and timing must support one another."
        },
        {
          "id": "bug_report",
          "label": "Bug report",
          "subject": "a software bug report",
          "context": "Environment, reproduction steps, observed result, expected result, and evidence determine its diagnostic value."
        },
        {
          "id": "research_abstract",
          "label": "Research abstract",
          "subject": "a research abstract",
          "context": "Question, method, result, limitation, and contribution must remain proportional to evidence."
        }
      ],
      "intents": [
        {
          "id": "identify",
          "label": "identify the most important weakness",
          "goalTemplate": "Identify the most important weakness in {subject}."
        },
        {
          "id": "revise",
          "label": "revise the weak section",
          "goalTemplate": "Revise the weakest section of {subject} without changing supported meaning."
        },
        {
          "id": "consistency",
          "label": "check internal consistency",
          "goalTemplate": "Check {subject} for internal consistency."
        },
        {
          "id": "evidence",
          "label": "strengthen the evidence connection",
          "goalTemplate": "Strengthen the connection between claims and evidence in {subject}."
        },
        {
          "id": "prioritize",
          "label": "prioritize the necessary fixes",
          "goalTemplate": "Prioritize the fixes that would most improve {subject}."
        },
        {
          "id": "prioritize_revision",
          "label": "prioritize revisions by impact",
          "goalTemplate": "Prioritize revisions to {subject} by impact, evidence, and effort."
        }
      ],
      "constraints": [
        {
          "id": "specific",
          "label": "Tie every criticism to a specific part of the draft."
        },
        {
          "id": "preserve_intent",
          "label": "Preserve the author's supported purpose and meaning."
        },
        {
          "id": "no_invention",
          "label": "Do not invent facts, evidence, or commitments during revision."
        },
        {
          "id": "priority",
          "label": "Separate blocking problems from optional improvements."
        },
        {
          "id": "actionable",
          "label": "Make every recommended change concrete enough to apply."
        },
        {
          "id": "proportionate",
          "label": "Keep the depth of critique proportionate to the requested scope."
        },
        {
          "id": "preserve_strengths",
          "label": "Preserve verified strengths while correcting the selected weakness."
        },
        {
          "id": "claim_evidence_link",
          "label": "Name the claim-evidence link revised."
        }
      ],
      "states": [
        {
          "id": "unclear",
          "label": "The main point is present but difficult to identify."
        },
        {
          "id": "unsupported",
          "label": "A material claim lacks visible support."
        },
        {
          "id": "inconsistent",
          "label": "Two parts of the draft do not agree."
        },
        {
          "id": "overloaded",
          "label": "Too many secondary issues obscure the central task."
        },
        {
          "id": "nearly_ready",
          "label": "The draft is usable but needs one focused correction."
        },
        {
          "id": "mixed_quality",
          "label": "The draft has strong evidence but weak organization."
        }
      ],
      "outcomes": [
        {
          "id": "key_issue",
          "label": "The highest-impact weakness is identified with a clear reason."
        },
        {
          "id": "improved_draft",
          "label": "The revised section is clearer without adding unsupported meaning."
        },
        {
          "id": "consistent",
          "label": "The relevant parts of the draft use compatible claims and terms."
        },
        {
          "id": "evidence_aligned",
          "label": "Each material claim has proportionate visible support."
        },
        {
          "id": "ordered_fixes",
          "label": "Required fixes are ordered by impact and dependency."
        },
        {
          "id": "reviewable_change",
          "label": "Every proposed change can be reviewed against the source draft."
        },
        {
          "id": "ranked_revision",
          "label": "The revision order addresses the highest-impact weakness first."
        }
      ],
      "fallbacks": [
        {
          "id": "retain_caveat",
          "label": "Retain the caveat explicitly when shortening the text."
        },
        {
          "id": "missing_fact",
          "label": "Request the missing fact instead of inventing a bridge sentence."
        },
        {
          "id": "pause",
          "label": "Pause before commitment and preserve the current confirmed state."
        }
      ],
      "compatibility": {
