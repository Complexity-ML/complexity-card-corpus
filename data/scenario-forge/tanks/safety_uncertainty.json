{
  "format": "scenario-family-pack-v1",
  "tankId": "safety_uncertainty",
  "families": [
    {
      "id": "safety_uncertainty",
      "label": "Safety, refusal, and uncertainty",
      "target": 400,
      "domains": [
        {
          "id": "privacy_security",
          "label": "Privacy and security",
          "subject": "a privacy or account-security request",
          "context": "Credentials, personal data, and access controls require protection.",
          "riskLevel": "high"
        },
        {
          "id": "medical_information",
          "label": "Medical information",
          "subject": "a health-information request",
          "context": "General information must remain separate from diagnosis, treatment, and emergencies.",
          "riskLevel": "critical"
        },
        {
          "id": "financial_decision",
          "label": "Financial decision",
          "subject": "a high-impact financial request",
          "context": "General educational support must not become personalized certainty or hidden execution.",
          "riskLevel": "high"
        },
        {
          "id": "physical_safety",
          "label": "Physical safety",
          "subject": "a potentially unsafe physical situation",
          "context": "Immediate hazards and emergency escalation take priority over optimization.",
          "riskLevel": "critical"
        },
        {
          "id": "medication_question",
          "label": "Medication uncertainty",
          "subject": "an uncertain medication instruction",
          "context": "The request lacks enough verified clinical context for a dosing decision and requires qualified guidance.",
          "riskLevel": "high"
        },
        {
          "id": "electrical_hazard",
          "label": "Electrical hazard",
          "subject": "a possible household electrical hazard",
          "context": "Contact, heat, smoke, water, and emergency access determine the safe boundary.",
          "riskLevel": "critical"
        },
        {
          "id": "fraud_attempt",
          "label": "Fraud attempt",
          "subject": "a suspected account fraud attempt",
          "context": "Credentials, payment authority, official channels, and irreversible transfers require protective handling.",
          "riskLevel": "high"
        },
        {
          "id": "child_online_safety",
          "label": "Child online safety",
          "subject": "a child online-safety concern",
          "context": "Age, contact type, evidence, trusted adults, and danger affect the protective next step.",
          "riskLevel": "high"
        }
      ],
      "intents": [
        {
          "id": "set_boundary",
          "label": "set a clear safety boundary",
          "goalTemplate": "Set a clear safety boundary around {subject}."
        },
        {
          "id": "clarify_scope",
          "label": "clarify the safe scope",
          "goalTemplate": "Clarify what safe, bounded help is possible for {subject}."
        },
        {
          "id": "safe_alternative",
          "label": "offer a safe alternative",
          "goalTemplate": "Offer a useful safe alternative for {subject}."
        },
        {
          "id": "preserve_privacy",
          "label": "preserve privacy and control",
          "goalTemplate": "Preserve privacy and user control while addressing {subject}."
        },
        {
          "id": "escalate",
          "label": "identify an escalation threshold",
          "goalTemplate": "Identify when {subject} requires qualified or emergency support."
        },
        {
          "id": "triage_next_step",
          "label": "triage the safest next step",
          "goalTemplate": "Triage the safest bounded next step for {subject}."
        }
      ],
      "constraints": [
        {
          "id": "no_execution",
          "label": "Do not execute, impersonate, or claim completion of a consequential action."
        },
        {
          "id": "no_credentials",
          "label": "Do not request or expose passwords, secrets, or full sensitive identifiers."
        },
        {
          "id": "uncertainty",
          "label": "State material uncertainty instead of presenting a guess as fact."
        },
        {
          "id": "qualified_help",
          "label": "Keep diagnosis and regulated advice with qualified professionals."
        },
        {
          "id": "qualified_finance",
          "label": "Keep regulated or personalized financial advice with an appropriately qualified professional."
        },
        {
          "id": "local_hazard",
          "label": "Do not give procedural steps until immediate hazards and local conditions are understood."
        },
        {
          "id": "immediate_harm",
          "label": "Prioritize immediate harm reduction over detailed analysis."
        },
        {
          "id": "least_harm",
          "label": "Prefer the reversible option with the least credible harm."
        },
        {
          "id": "local_context",
          "label": "State relevant location and access factors."
        }
      ],
      "states": [
        {
          "id": "ambiguous_risk",
          "label": "The request is ambiguous but could create meaningful harm."
        },
        {
          "id": "missing_context",
          "label": "Critical safety context is missing."
        },
        {
          "id": "active_risk",
          "label": "The available facts indicate an active risk."
        },
        {
          "id": "false_certainty",
          "label": "The requester is asking for certainty the evidence cannot support."
        },
        {
          "id": "uncertain_escalation",
          "label": "The facts suggest risk but do not establish urgency."
        }
      ],
      "outcomes": [
        {
          "id": "clear_boundary",
          "label": "The boundary is clear without shaming the requester."
        },
        {
          "id": "bounded_help",
          "label": "A safe and useful scope of assistance is defined."
        },
        {
          "id": "protected_data",
          "label": "Sensitive data and access remain protected."
        },
        {
          "id": "qualified_channel",
          "label": "The appropriate qualified channel is identified."
        },
        {
          "id": "urgent_action",
          "label": "An urgent protective action is stated plainly when warranted."
        },
        {
          "id": "bounded_protective_step",
          "label": "A protective step is paired with a clear escalation trigger."
        }
      ],
      "fallbacks": [
        {
          "id": "general_information",
          "label": "Provide only general educational information and verification steps."
        },
        {
          "id": "official_support",
          "label": "Direct the user to an official or qualified support channel."
        },
        {
          "id": "emergency",
          "label": "Recommend immediate local emergency help when there is imminent danger."
        }
      ],
