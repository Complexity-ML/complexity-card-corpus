{
  "format": "scenario-family-pack-v1",
  "tankId": "extraction_classification",
  "families": [
    {
      "id": "extraction_classification",
      "label": "Extraction and classification",
      "target": 5280,
      "domains": [
        {
          "id": "receipt",
          "label": "Receipt",
          "subject": "a purchase receipt",
          "context": "Dates, amounts, merchant details, taxes, and line items appear in semi-structured text."
        },
        {
          "id": "event_listing",
          "label": "Event listing",
          "subject": "an event listing",
          "context": "Title, location, schedule, eligibility, and registration details need consistent fields."
        },
        {
          "id": "contact_record",
          "label": "Contact record",
          "subject": "a contact record",
          "context": "Names, roles, organizations, and communication details must remain correctly associated."
        },
        {
          "id": "issue_ticket",
          "label": "Issue ticket",
          "subject": "a software issue ticket",
          "context": "Symptoms, environment, severity, reproduction details, and status are mixed in prose."
        },
        {
          "id": "survey_response",
          "label": "Survey response",
          "subject": "a survey response",
          "context": "The response contains a rating, a topic, free-form feedback, and possible ambiguity."
        },
        {
          "id": "inventory_record",
          "label": "Inventory record",
          "subject": "an inventory record",
          "context": "Item identity, quantity, location, condition, and update time require normalization."
        },
        {
          "id": "schedule_entry",
          "label": "Schedule entry",
          "subject": "a schedule entry",
          "context": "Time, duration, participants, location, and recurrence need explicit representation."
        },
        {
          "id": "case_note",
          "label": "Case note",
          "subject": "a short case note",
          "context": "Observed facts, reported claims, actions, and pending items must remain distinguishable."
        },
        {
          "id": "address_record",
          "label": "Address record",
          "subject": "a postal address record",
          "context": "Recipient, street, locality, postal code, country, and delivery notes need separate fields."
        },
        {
          "id": "booking_record",
          "label": "Booking record",
          "subject": "a booking confirmation",
          "context": "Reference, service, date, time, party size, and cancellation state require normalization."
        },
        {
          "id": "product_record",
          "label": "Product record",
          "subject": "a product listing",
          "context": "Product identity, variant, price, availability, and warranty details appear in mixed text."
        },
        {
          "id": "expense_record",
          "label": "Expense record",
          "subject": "an expense entry",
          "context": "Category, amount, currency, date, payment method, and approval state need consistent types."
        },
        {
          "id": "shipment_record",
          "label": "Shipment record",
          "subject": "a shipment update",
          "context": "Tracking reference, carrier, destination, milestone, timestamp, and exception must remain associated."
        },
        {
          "id": "calendar_record",
          "label": "Calendar record",
          "subject": "a calendar invitation",
          "context": "Organizer, participants, start, end, location, and response status need explicit representation."
        },
        {
          "id": "measurement_record",
          "label": "Measurement record",
          "subject": "a measurement note",
          "context": "Measured value, unit, instrument, timestamp, tolerance, and observer need traceable fields."
        },
        {
          "id": "bibliographic_record",
          "label": "Bibliographic record",
          "subject": "a publication citation",
          "context": "Title, author, year, venue, identifier, and page range require careful separation."
        },
        {
          "id": "shipment_manifest",
          "label": "Shipment manifest",
          "subject": "a shipment manifest",
          "context": "Packages, quantities, destinations, status codes, and missing identifiers must map to explicit fields."
        },
        {
          "id": "survey_export",
          "label": "Survey export",
          "subject": "a survey response export",
          "context": "Question identifiers, response types, skipped items, and multi-select values require stable normalization."
        },
        {
          "id": "api_response",
          "label": "API response",
          "subject": "a nested API response",
          "context": "Objects, arrays, nulls, identifiers, and error records must preserve their source paths."
        },
        {
          "id": "administrative_form",
          "label": "Administrative form",
          "subject": "a structured administrative form",
          "context": "Applicant fields, dates, selections, attestations, and omissions require schema-faithful extraction."
        }
      ],
      "intents": [
        {
          "id": "extract",
          "label": "extract the requested fields",
          "goalTemplate": "Extract requested fields from {subject}."
        },
        {
          "id": "normalize",
          "label": "normalize the recorded values",
          "goalTemplate": "Normalize the values in {subject} without changing their meaning."
        },
        {
          "id": "classify",
          "label": "classify the record",
          "goalTemplate": "Classify {subject} using a stated label set."
        },
        {
          "id": "missing",
          "label": "identify missing required fields",
          "goalTemplate": "Identify required information missing from {subject}."
        },
        {
          "id": "structure",
          "label": "convert the record into a clear structure",
          "goalTemplate": "Convert {subject} into a clear structured representation."
        },
        {
          "id": "standardize_records",
          "label": "standardize records into one schema",
          "goalTemplate": "Normalize the records in {subject} into one explicit schema."
        }
      ],
      "constraints": [
        {
          "id": "schema_only",
          "label": "Use only fields defined by the requested schema."
        },
        {
          "id": "null_missing",
          "label": "Represent absent information explicitly instead of guessing a value."
        },
        {
          "id": "preserve_value",
          "label": "Preserve source values unless a stated normalization rule applies."
        },
        {
          "id": "single_label",
          "label": "Choose only from the provided classification labels."
        },
        {
          "id": "traceable",
          "label": "Keep every extracted value traceable to the source text."
        },
        {
          "id": "valid_format",
          "label": "Return a syntactically valid structure with consistent field types."
        },
        {
          "id": "schema_fidelity",
          "label": "Preserve missing, null, and conflicting values."
        },
        {
          "id": "provenance_column",
          "label": "Link values to source fields."
        }
      ],
      "states": [
        {
          "id": "complete_unstructured",
          "label": "All required information is present but unstructured."
        },
        {
          "id": "partially_missing",
          "label": "At least one required field is absent."
        },
        {
          "id": "inconsistent_format",
          "label": "Equivalent values use inconsistent formats."
        },
        {
          "id": "ambiguous_label",
          "label": "The record could plausibly fit more than one label."
        },
        {
          "id": "mixed_content",
          "label": "Relevant fields are mixed with unrelated prose."
        },
        {
          "id": "mixed_formats",
          "label": "Equivalent records use inconsistent formats and field names."
        }
      ],
      "outcomes": [
        {
          "id": "complete_fields",
          "label": "All supported requested fields are populated correctly."
        },
        {
          "id": "explicit_missing",
          "label": "Missing fields are represented explicitly without fabricated values."
        },
        {
          "id": "normalized",
          "label": "Equivalent values use one documented format."
        },
        {
          "id": "valid_class",
          "label": "The selected class follows the stated label definition."
        },
        {
          "id": "valid_structure",
          "label": "The output conforms to the requested schema and data types."
        },
        {
          "id": "traceable_values",
          "label": "Every output value can be traced to its source evidence."
        },
        {
          "id": "normalized_records",
          "label": "Records share one schema while conflicts remain traceable."
        }
      ],
      "fallbacks": [
        {
          "id": "missing_fact",
          "label": "Request the missing fact instead of inventing a bridge sentence."
        },
        {
          "id": "pause",
          "label": "Pause before commitment and preserve the current confirmed state."
        },
        {
          "id": "source_check",
          "label": "Name the unresolved claim and suggest an authoritative source check."
        }
      ],
      "compatibility": {
