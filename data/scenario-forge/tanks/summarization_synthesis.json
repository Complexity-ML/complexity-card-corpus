{
  "format": "scenario-family-pack-v1",
  "tankId": "summarization_synthesis",
  "families": [
    {
      "id": "summarization_synthesis",
      "label": "Summarization and synthesis",
      "target": 3600,
      "domains": [
        {
          "id": "meeting_transcript",
          "label": "Meeting transcript",
          "subject": "a meeting transcript",
          "context": "The source mixes decisions, open questions, owners, and conversational detail."
        },
        {
          "id": "research_notes",
          "label": "Research notes",
          "subject": "a set of research notes",
          "context": "Findings, hypotheses, limitations, and follow-up ideas appear at different levels of confidence."
        },
        {
          "id": "support_thread",
          "label": "Support thread",
          "subject": "a customer-support thread",
          "context": "Symptoms, attempted fixes, account facts, and unresolved questions are spread across several messages."
        },
        {
          "id": "project_update",
          "label": "Project update",
          "subject": "a detailed project update",
          "context": "Progress, blockers, dependencies, dates, and ownership need a compact shared view."
        },
        {
          "id": "policy_memo",
          "label": "Policy memo",
          "subject": "a policy memo",
          "context": "The memo contains a purpose, operative rules, exceptions, and implementation notes."
        },
        {
          "id": "article_excerpt",
          "label": "Article excerpt",
          "subject": "a long article excerpt",
          "context": "The source contains a central claim, supporting points, qualifications, and illustrative detail."
        },
        {
          "id": "incident_log",
          "label": "Incident log",
          "subject": "an incident log",
          "context": "Events, interventions, observed effects, and unresolved causes follow a time sequence."
        },
        {
          "id": "learning_notes",
          "label": "Learning notes",
          "subject": "a collection of learning notes",
          "context": "Definitions, examples, questions, and partial conclusions need a reusable structure."
        },
        {
          "id": "design_review",
          "label": "Design review",
          "subject": "a product design review",
          "context": "Decisions, proposals, objections, owners, and unresolved questions occur at different points in the discussion."
        },
        {
          "id": "incident_timeline",
          "label": "Incident timeline",
          "subject": "an incident timeline",
          "context": "Events, interventions, hypotheses, and confirmed causes must retain their chronology and evidential status."
        },
        {
          "id": "field_observations",
          "label": "Field observations",
          "subject": "a collection of field observations",
          "context": "Sources, interpretations, measurements, and open questions vary in reliability and relevance."
        },
        {
          "id": "customer_interviews",
          "label": "Customer interviews",
          "subject": "a set of customer interviews",
          "context": "Recurring needs, minority experiences, direct observations, and suggested solutions must not be conflated."
        },
        {
          "id": "audit_findings",
          "label": "Audit findings",
          "subject": "a set of audit findings",
          "context": "Exceptions, owners, due dates, disputed evidence, and remediation require attribution."
        },
        {
          "id": "experiment_log",
          "label": "Experiment log",
          "subject": "a sequence of experiment notes",
          "context": "Hypothesis, intervention, observation, failure, and uncertainty must stay distinct."
        },
        {
          "id": "procurement_review",
          "label": "Procurement review",
          "subject": "a procurement review record",
          "context": "Requirements, evidence, exclusions, disagreement, and pending approval determine the summary."
        },
        {
          "id": "training_feedback",
          "label": "Training feedback",
          "subject": "a collection of training feedback",
          "context": "Learning, preference, access, response, and follow-up carry different evidential weight."
        },
        {
          "id": "maintenance_handover",
          "label": "Maintenance handover",
          "subject": "a maintenance handover log",
          "context": "Completed work, workaround, asset condition, owner, and unresolved fault define the synthesis."
        },
        {
          "id": "legal_case_notes",
          "label": "Case notes",
          "subject": "a set of procedural case notes",
          "context": "Events, source roles, deadlines, disputes, and pending steps require separation."
        },
        {
          "id": "release_retrospective",
          "label": "Release retrospective",
          "subject": "a software-release retrospective",
          "context": "Outcome, deployment issue, response, owner, and unresolved cause must remain traceable."
        },
        {
          "id": "public_consultation",
          "label": "Public consultation",
          "subject": "a public-consultation record",
          "context": "Majority preference, minority concern, facts, remedy, and undecided policy need separation."
        }
      ],
      "intents": [
        {
          "id": "essentials",
          "label": "summarize the essentials",
          "goalTemplate": "Summarize the essential information in {subject}."
        },
        {
          "id": "synthesize",
          "label": "synthesize related points",
          "goalTemplate": "Synthesize related points from {subject} without flattening disagreement."
        },
        {
          "id": "decisions",
          "label": "extract decisions and actions",
          "goalTemplate": "Extract decisions and actions from {subject}."
        },
        {
          "id": "chronology",
          "label": "organize the chronology",
          "goalTemplate": "Organize the chronology recorded in {subject}."
        },
        {
          "id": "audience",
          "label": "adapt the summary for its audience",
          "goalTemplate": "Adapt a faithful summary of {subject} for a stated audience."
        },
        {
          "id": "trace_decisions",
          "label": "trace decisions to evidence",
          "goalTemplate": "Trace each material decision in {subject} to its supporting evidence."
        }
      ],
      "constraints": [
        {
          "id": "source_fidelity",
          "label": "Preserve every material claim from the source without adding new facts."
        },
        {
          "id": "brevity",
          "label": "Remove repetition while retaining decisions, caveats, and unresolved questions."
        },
        {
          "id": "attribution",
          "label": "Keep speakers or sources attached to claims when attribution matters."
        },
        {
          "id": "uncertainty",
          "label": "Preserve uncertainty and disagreement instead of converting them into consensus."
        },
        {
          "id": "structure",
          "label": "Use a structure that makes the requested information easy to scan."
        },
        {
          "id": "priority",
          "label": "Distinguish central information from supporting detail."
        },
        {
          "id": "source_priority",
          "label": "Preserve the stated priority among source roles."
        },
        {
          "id": "minority_view",
          "label": "Retain different minority views."
        }
      ],
      "states": [
        {
          "id": "verbose",
          "label": "The source is accurate but substantially too long."
        },
        {
          "id": "fragmented",
          "label": "Relevant information is scattered across the source."
        },
        {
          "id": "repetitive",
          "label": "Several points are repeated in slightly different wording."
        },
        {
          "id": "mixed_confidence",
          "label": "Facts, interpretations, and open questions are mixed together."
        },
        {
          "id": "audience_mismatch",
          "label": "The current summary does not match the reader's needs."
        },
        {
          "id": "mixed_relevance",
          "label": "The material mixes decisive evidence with secondary detail."
        }
      ],
      "outcomes": [
        {
          "id": "core_summary",
          "label": "The central information is captured without material omission."
        },
        {
          "id": "linked_synthesis",
          "label": "Related points are combined while meaningful differences remain visible."
        },
        {
          "id": "actions",
          "label": "Decisions, owners, and next actions are easy to identify."
        },
        {
          "id": "timeline",
          "label": "The sequence of events is accurate and easy to follow."
        },
        {
          "id": "audience_fit",
          "label": "The summary serves the stated audience without changing the source meaning."
        },
        {
          "id": "open_questions",
          "label": "Unresolved questions and caveats remain explicit."
        },
        {
          "id": "traceable_summary",
          "label": "Every material summary point remains traceable to its source role."
        }
      ],
      "fallbacks": [
        {
          "id": "retain_caveat",
          "label": "Retain the caveat explicitly when shortening the text."
        },
        {
          "id": "missing_fact",
          "label": "Request the missing fact instead of inventing a bridge sentence."
        },
        {
          "id": "pause",
          "label": "Pause before commitment and preserve the current confirmed state."
        }
      ],
      "compatibility": {
        "intentOutcomes": {
