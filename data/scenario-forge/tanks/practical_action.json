{
  "format": "scenario-family-pack-v1",
  "tankId": "practical_action",
  "families": [
    {
      "id": "practical_action",
      "label": "Practical action",
      "target": 760,
      "domains": [
        {
          "id": "appointments",
          "label": "Appointments",
          "subject": "an appointment",
          "context": "A person needs a specific service slot and a verifiable confirmation."
        },
        {
          "id": "air_travel",
          "label": "Air travel",
          "subject": "a flight booking",
          "context": "A traveller must act within carrier rules and a fixed travel window."
        },
        {
          "id": "parcel_delivery",
          "label": "Parcel delivery",
          "subject": "a parcel delivery",
          "context": "Tracking information and the physical delivery state do not yet fully agree."
        },
        {
          "id": "account_access",
          "label": "Account access",
          "subject": "access to an online account",
          "context": "Identity must be verified without exposing credentials or bypassing controls.",
          "riskLevel": "medium"
        },
        {
          "id": "subscriptions",
          "label": "Subscriptions",
          "subject": "a recurring subscription",
          "context": "Renewal terms, billing dates, and cancellation effects must remain explicit."
        },
        {
          "id": "event_registration",
          "label": "Event registration",
          "subject": "an event registration",
          "context": "Capacity, eligibility, and confirmation status may change before the event."
        },
        {
          "id": "home_repair",
          "label": "Home repair",
          "subject": "a home repair visit",
          "context": "The scope and price need confirmation before work begins."
        },
        {
          "id": "banking_admin",
          "label": "Banking administration",
          "subject": "a routine banking request",
          "context": "The action must use official channels and preserve an auditable record.",
          "riskLevel": "medium"
        },
        {
          "id": "healthcare_admin",
          "label": "Healthcare administration",
          "subject": "a healthcare administration request",
          "context": "The task concerns scheduling or records, not diagnosis or treatment.",
          "riskLevel": "medium"
        },
        {
          "id": "course_enrolment",
          "label": "Course enrolment",
          "subject": "a course enrolment",
          "context": "Prerequisites, deadlines, and available places determine the next step."
        },
        {
          "id": "retail_returns",
          "label": "Retail returns",
          "subject": "a retail return",
          "context": "The item condition, proof of purchase, and policy window matter."
        },
        {
          "id": "public_transit",
          "label": "Public transit",
          "subject": "a public-transit journey",
          "context": "Service changes and accessibility needs can alter the workable route."
        },
        {
          "id": "utility_move",
          "label": "Utility transfer",
          "subject": "a household utility transfer",
          "context": "Service address, activation date, final meter state, and account ownership must remain aligned."
        },
        {
          "id": "vehicle_service",
          "label": "Vehicle service",
          "subject": "a vehicle service appointment",
          "context": "Reported symptoms, authorized work, parts availability, and collection timing determine the next action."
        },
        {
          "id": "document_renewal",
          "label": "Document renewal",
          "subject": "an official document renewal",
          "context": "Eligibility, identity evidence, expiry date, and delivery method must be verified before submission."
        },
        {
          "id": "venue_booking",
          "label": "Venue booking",
          "subject": "a venue reservation",
          "context": "Capacity, access window, cancellation terms, and named organizer constrain the booking."
        }
      ],
      "intents": [
        {
          "id": "arrange",
          "label": "arrange the next step",
          "goalTemplate": "Arrange the next verifiable step for {subject}."
        },
        {
          "id": "change",
          "label": "change an existing arrangement",
          "goalTemplate": "Change an existing arrangement involving {subject} without losing confirmed details."
        },
        {
          "id": "cancel",
          "label": "cancel or reverse an arrangement",
          "goalTemplate": "Cancel or reverse {subject} while making consequences explicit."
        },
        {
          "id": "verify",
          "label": "confirm requirements and status",
          "goalTemplate": "Confirm the requirements and current status of {subject} before acting."
        },
        {
          "id": "resolve",
          "label": "resolve a discrepancy",
          "goalTemplate": "Resolve a discrepancy involving {subject} through a documented next step."
        },
        {
          "id": "document",
          "label": "record the owned decision",
          "goalTemplate": "Document the actionable decision for {subject} with a named owner."
        }
      ],
      "constraints": [
        {
          "id": "deadline",
          "label": "The action must be completed before a fixed deadline."
        },
        {
          "id": "budget",
          "label": "The total cost cannot exceed a stated budget."
        },
        {
          "id": "accessibility",
          "label": "The result must preserve a stated accessibility need."
        },
        {
          "id": "limited_information",
          "label": "Only partial reference information is currently available."
        },
        {
          "id": "reversible",
          "label": "No irreversible action may occur before explicit confirmation."
        },
        {
          "id": "ownership",
          "label": "Name the owner of every next step."
        },
        {
          "id": "confirmation_record",
          "label": "Keep a checkable record."
        }
      ],
      "states": [
        {
          "id": "not_started",
          "label": "No action has been taken yet."
        },
        {
          "id": "pending",
          "label": "A request exists but has not been confirmed."
        },
        {
          "id": "conflict",
          "label": "Two available records contain conflicting details."
        },
        {
          "id": "failed_attempt",
          "label": "One reasonable attempt failed without resolving the task."
        },
        {
          "id": "awaiting_owner",
          "label": "The next action has no confirmed owner."
        }
      ],
      "outcomes": [
        {
          "id": "confirmed_step",
          "label": "A concrete next step is confirmed with owner and timing."
        },
        {
          "id": "corrected_record",
          "label": "The relevant record is corrected and the change is documented."
        },
        {
          "id": "clear_requirements",
          "label": "Requirements and missing information are separated clearly."
        },
        {
          "id": "reversible_choice",
          "label": "A safe reversible option is selected pending final confirmation."
        },
        {
          "id": "escalation_path",
          "label": "A justified escalation path is identified with the required evidence."
        },
        {
          "id": "owned_action",
          "label": "The next action has an owner, timing, and confirmation."
        }
      ],
      "fallbacks": [
        {
          "id": "pause",
          "label": "Pause before commitment and preserve the current confirmed state."
        },
        {
          "id": "official_channel",
          "label": "Use the provider's official support channel with a concise evidence summary."
        },
        {
          "id": "alternative",
          "label": "Choose a bounded alternative that still satisfies the hard constraint."
        }
      ],
