{
  "format": "scenario-family-pack-v1",
  "tankId": "brainstorming_creativity",
  "families": [
    {
      "id": "brainstorming_creativity",
      "label": "Brainstorming and constrained creativity",
      "target": 2920,
      "domains": [
        {
          "id": "names",
          "label": "Names and labels",
          "subject": "a set of names for a small project",
          "context": "The options should be memorable, distinct, and appropriate for a stated audience."
        },
        {
          "id": "lesson_activity",
          "label": "Learning activity",
          "subject": "a short learning activity",
          "context": "The activity should connect one learning objective to observable participation."
        },
        {
          "id": "event_plan",
          "label": "Event ideas",
          "subject": "ideas for a small community event",
          "context": "Available time, space, accessibility, and budget constrain the format."
        },
        {
          "id": "feature_ideas",
          "label": "Feature ideas",
          "subject": "feature ideas for a simple product",
          "context": "Each idea should address a named user need without expanding the scope uncontrollably."
        },
        {
          "id": "writing_prompts",
          "label": "Writing prompts",
          "subject": "a set of short writing prompts",
          "context": "The prompts should vary in perspective while respecting a shared theme and audience."
        },
        {
          "id": "low_cost_activity",
          "label": "Low-cost activities",
          "subject": "ideas for a low-cost activity",
          "context": "The activity must use common materials and avoid hidden costs or specialist access."
        },
        {
          "id": "outreach",
          "label": "Outreach ideas",
          "subject": "ideas for a small outreach effort",
          "context": "The message, channel, audience, and desired response should align."
        },
        {
          "id": "workflow",
          "label": "Workflow improvements",
          "subject": "ideas for improving a simple workflow",
          "context": "Suggestions should reduce friction without removing necessary checks."
        },
        {
          "id": "museum_exhibit",
          "label": "Museum exhibit",
          "subject": "an interactive museum exhibit",
          "context": "Audience movement, learning goal, physical constraints, and participation mechanics create distinct design directions."
        },
        {
          "id": "community_workshop",
          "label": "Community workshop",
          "subject": "a community workshop",
          "context": "Participant needs, facilitation format, available materials, and follow-up define workable concepts."
        },
        {
          "id": "learning_game",
          "label": "Learning game",
          "subject": "a small learning game",
          "context": "Target skill, player choice, feedback, progression, and replay value support different mechanisms."
        },
        {
          "id": "sustainability_campaign",
          "label": "Sustainability campaign",
          "subject": "a local sustainability campaign",
          "context": "Audience, measurable behavior, channel, incentive, and trust constraints shape viable ideas."
        }
      ],
      "intents": [
        {
          "id": "generate",
          "label": "generate several distinct options",
          "goalTemplate": "Generate several distinct options for {subject}."
        },
        {
          "id": "diversify",
          "label": "diversify the current ideas",
          "goalTemplate": "Diversify the current ideas for {subject}."
        },
        {
          "id": "filter",
          "label": "filter ideas against the criteria",
          "goalTemplate": "Filter ideas for {subject} against explicit criteria."
        },
        {
          "id": "combine",
          "label": "combine compatible concepts",
          "goalTemplate": "Combine compatible concepts into stronger options for {subject}."
        },
        {
          "id": "develop",
          "label": "develop one promising idea",
          "goalTemplate": "Develop one promising idea for {subject} into a bounded proposal."
        },
        {
          "id": "synthesize_mechanisms",
          "label": "synthesize complementary mechanisms",
          "goalTemplate": "Combine complementary mechanisms into distinct options for {subject}."
        }
      ],
      "constraints": [
        {
          "id": "distinct",
          "label": "Make the options meaningfully different rather than cosmetic rewrites."
        },
        {
          "id": "feasible",
          "label": "Keep every option feasible within the stated resources."
        },
        {
          "id": "audience",
          "label": "Keep the intended audience visible in each option."
        },
        {
          "id": "safe",
          "label": "Avoid ideas that create unnecessary safety, privacy, or exclusion risks."
        },
        {
          "id": "criteria",
          "label": "Explain briefly how each retained option meets the named criteria."
        },
        {
          "id": "bounded",
          "label": "Keep the proposal small enough to test and revise."
        },
        {
          "id": "distinct_mechanisms",
          "label": "Make options differ in mechanism, not wording."
        },
        {
          "id": "feasibility_test",
          "label": "Give each idea a cheap test."
        }
      ],
      "states": [
        {
          "id": "blank",
          "label": "No candidate idea has been proposed yet."
        },
        {
          "id": "similar",
          "label": "The current ideas are too similar to one another."
        },
        {
          "id": "too_broad",
          "label": "The current concept is too broad to evaluate."
        },
        {
          "id": "constraint_conflict",
          "label": "One appealing idea conflicts with a hard constraint."
        },
        {
          "id": "promising",
          "label": "One option is promising but not yet concrete."
        },
        {
          "id": "narrow_pool",
          "label": "The idea pool contains cosmetic variants of one mechanism."
        }
      ],
      "outcomes": [
        {
          "id": "distinct_options",
          "label": "The candidate options differ in a meaningful and useful way."
        },
        {
          "id": "criteria_fit",
          "label": "Each retained option satisfies the stated criteria."
        },
        {
          "id": "feasible_set",
          "label": "The remaining ideas are feasible within the available resources."
        },
        {
          "id": "combined_concept",
          "label": "Compatible strengths are combined without preserving their conflicts."
        },
        {
          "id": "testable_proposal",
          "label": "One idea is developed into a small testable proposal."
        },
        {
          "id": "tradeoffs",
          "label": "The main trade-off of each leading option is visible."
        },
        {
          "id": "complementary_set",
          "label": "The options cover complementary mechanisms and explicit trade-offs."
        }
      ],
      "fallbacks": [
        {
          "id": "smaller_scope",
          "label": "Choose a smaller reversible scope that still tests the plan."
        },
        {
          "id": "pause",
          "label": "Pause before commitment and preserve the current confirmed state."
        },
        {
          "id": "missing_fact",
          "label": "Request the missing fact instead of inventing a bridge sentence."
        }
      ],
      "compatibility": {
