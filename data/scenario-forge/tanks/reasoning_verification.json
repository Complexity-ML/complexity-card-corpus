{
  "format": "scenario-family-pack-v1",
  "tankId": "reasoning_verification",
  "families": [
    {
      "id": "reasoning_verification",
      "label": "Reasoning and verification",
      "weight": 5000,
      "domains": [
        {
          "id": "shopping_arithmetic",
          "label": "Shopping arithmetic",
          "subject": "a small shopping calculation",
          "context": "Prices, quantities, discounts, and a stated budget provide all necessary values."
        },
        {
          "id": "schedule_math",
          "label": "Schedule arithmetic",
          "subject": "a scheduling calculation",
          "context": "Start times, durations, breaks, and deadlines determine the feasible timeline."
        },
        {
          "id": "unit_conversion",
          "label": "Unit conversion",
          "subject": "a practical unit conversion",
          "context": "The source provides the quantity, units, and conversion relationship."
        },
        {
          "id": "proportions",
          "label": "Proportions",
          "subject": "a proportional reasoning problem",
          "context": "Two known quantities define a ratio that must remain consistent."
        },
        {
          "id": "table_comparison",
          "label": "Table comparison",
          "subject": "a numerical comparison table",
          "context": "Several options share comparable measurements with occasional missing values."
        },
        {
          "id": "sequence_pattern",
          "label": "Sequence pattern",
          "subject": "a short sequence problem",
          "context": "A limited sequence supports one simple pattern that must be checked against every term."
        },
        {
          "id": "logical_constraints",
          "label": "Logical constraints",
          "subject": "a compact constraint problem",
          "context": "A small set of explicit rules determines which combinations are possible."
        },
        {
          "id": "simple_probability",
          "label": "Simple probability",
          "subject": "a basic probability question",
          "context": "A finite set of equally described outcomes provides the stated sample space."
        },
        {
          "id": "work_allocation",
          "label": "Work allocation",
          "subject": "an equal allocation across people and rounds",
          "context": "The counts define an even allocation."
        },
        {
          "id": "probability_puzzle",
          "label": "Probability puzzle",
          "subject": "a bounded probability problem",
          "context": "Events, conditioning information, sample space, and independence assumptions must be stated before calculation."
        },
        {
          "id": "rate_conversion",
          "label": "Rate conversion",
          "subject": "a multi-step rate conversion",
          "context": "Dimensions, time bases, conversion factors, significant precision, and target units provide independent checks."
        },
        {
          "id": "schedule_constraint",
          "label": "Schedule constraint",
          "subject": "a constrained scheduling problem",
          "context": "Durations, dependencies, resource conflicts, and deadlines determine whether a schedule is feasible."
        },
        {
          "id": "causal_claim",
          "label": "Causal claim",
          "subject": "a proposed causal explanation",
          "context": "Temporal order, alternative causes, intervention evidence, and measurement limits constrain the conclusion."
        },
        {
          "id": "discount_comparison",
          "label": "Discount comparison",
          "subject": "a comparison of two discounts",
          "context": "Base prices, percentage changes, fixed fees, ordering, and rounding determine the lower final amount."
        },
        {
          "id": "recipe_scaling",
          "label": "Recipe scaling",
          "subject": "a scaled ingredient calculation",
          "context": "Original servings, target servings, units, indivisible items, and rounding support verification."
        },
        {
          "id": "storage_capacity",
          "label": "Storage capacity",
          "subject": "a storage-capacity calculation",
          "context": "File sizes, units, reserved space, duplicates, and safety margin determine usable capacity."
        },
        {
          "id": "travel_time",
          "label": "Travel time",
          "subject": "a multi-stage travel-time calculation",
          "context": "Segment duration, waiting time, departure order, time zones, and transfer constraints determine arrival."
        },
        {
          "id": "measurement_uncertainty",
          "label": "Measurement uncertainty",
          "subject": "a comparison with measurement uncertainty",
          "context": "Values, error bounds, repeated observations, resolution, and overlap constrain the comparison."
        },
        {
          "id": "inventory_reconciliation",
          "label": "Inventory reconciliation",
          "subject": "an inventory reconciliation problem",
          "context": "Starting count, receipts, removals, damaged units, and observed remainder must balance independently."
        },
        {
          "id": "voting_threshold",
          "label": "Voting threshold",
          "subject": "a voting-threshold calculation",
          "context": "Eligible voters, abstentions, threshold definition, ties, and invalid ballots decide whether a proposal passes."
        }
      ],
      "intents": [
        {
          "id": "calculate",
          "label": "calculate the requested result",
          "goalTemplate": "Calculate the requested result for {subject}."
        },
        {
          "id": "compare",
          "label": "compare the available quantities",
          "goalTemplate": "Compare the available quantities in {subject}."
        },
        {
          "id": "constraint",
          "label": "test whether the constraint is satisfied",
          "goalTemplate": "Test whether {subject} satisfies the stated constraint."
        },
        {
          "id": "explain",
          "label": "explain the reasoning step by step",
          "goalTemplate": "Explain the reasoning for {subject} in checkable steps."
        },
        {
          "id": "verify",
          "label": "verify the proposed result",
          "goalTemplate": "Verify a proposed result for {subject} independently."
        },
        {
          "id": "test_counterexample",
          "label": "test the conclusion with a counterexample",
          "goalTemplate": "Test the conclusion about {subject} against the strongest relevant counterexample."
        }
      ],
      "constraints": [
        {
          "id": "show_work",
          "label": "Show the intermediate reasoning needed to check the result."
        },
        {
          "id": "given_values",
          "label": "Use only the values and rules supplied in the problem."
        },
        {
          "id": "units",
          "label": "Keep units attached to quantities throughout the calculation."
        },
        {
          "id": "precision",
          "label": "Use only the level of precision justified by the inputs."
        },
        {
          "id": "independent_check",
          "label": "Confirm the result through a second simple check."
        },
        {
          "id": "missing_value",
          "label": "Stop and identify any missing value required for a unique answer."
        },
        {
          "id": "explicit_assumptions",
          "label": "State every assumption used by the reasoning."
        },
        {
          "id": "dimensional_consistency",
          "label": "Use compatible units and frames."
        }
      ],
      "states": [
        {
          "id": "ready",
          "label": "All required values and rules are present."
        },
        {
          "id": "candidate",
          "label": "A candidate answer is available but has not been checked."
        },
        {
          "id": "unit_mismatch",
          "label": "The quantities currently use different units."
        },
        {
          "id": "conflicting_steps",
          "label": "Two reasoning paths produce different results."
        },
        {
          "id": "underspecified",
          "label": "One value required for a unique result is missing."
        },
        {
          "id": "unverified_branch",
          "label": "One supporting reasoning branch remains unchecked."
        }
      ],
      "outcomes": [
        {
          "id": "correct_result",
          "label": "The requested result follows from the supplied values and rules."
        },
        {
          "id": "clear_comparison",
          "label": "The quantities are compared on the same basis."
        },
        {
          "id": "constraint_status",
          "label": "The constraint is shown to hold or fail for a specific reason."
        },
        {
          "id": "checkable_steps",
          "label": "Each reasoning step can be checked independently."
        },
        {
          "id": "verified_result",
          "label": "A second method confirms the proposed result."
        },
        {
          "id": "missing_identified",
          "label": "The missing information required for a unique answer is explicit."
        },
        {
          "id": "survives_counterexample",
          "label": "The conclusion survives a counterexample or is narrowed."
        }
      ],
      "fallbacks": [
        {
          "id": "simpler_model",
          "label": "Return to a smaller causal model with fewer moving parts."
        },
        {
          "id": "counterexample",
          "label": "Use a counterexample to expose the exact point of confusion."
        },
        {
          "id": "source_check",
          "label": "Name the unresolved claim and suggest an authoritative source check."
        }
      ],
      "compatibility": {
