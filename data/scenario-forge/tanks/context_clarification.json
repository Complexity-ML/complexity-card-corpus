{
  "format": "scenario-family-pack-v1",
  "tankId": "context_clarification",
  "families": [
    {
      "id": "context_clarification",
      "label": "Context tracking and clarification",
      "target": 2880,
      "domains": [
        {
          "id": "ambiguous_request",
          "label": "Ambiguous request",
          "subject": "an ambiguous request",
          "context": "Several interpretations are possible and one choice would materially change the answer."
        },
        {
          "id": "missing_reference",
          "label": "Missing reference",
          "subject": "a request that refers to missing material",
          "context": "The requested work depends on a document, image, value, or earlier message that is not available."
        },
        {
          "id": "conflicting_instruction",
          "label": "Conflicting instruction",
          "subject": "a request with conflicting instructions",
          "context": "Two stated requirements cannot both be satisfied without a priority decision."
        },
        {
          "id": "unclear_pronoun",
          "label": "Unclear reference",
          "subject": "a request with an unclear reference",
          "context": "A pronoun or short label could refer to more than one previously mentioned item."
        },
        {
          "id": "incomplete_goal",
          "label": "Incomplete goal",
          "subject": "a request with an incomplete objective",
          "context": "The activity is named but the intended result is not yet defined."
        },
        {
          "id": "scope_boundary",
          "label": "Scope boundary",
          "subject": "a request with an uncertain scope",
          "context": "A narrow interpretation is safe while a broader interpretation would add unapproved work."
        },
        {
          "id": "format_preference",
          "label": "Output format",
          "subject": "a request with an unspecified output format",
          "context": "The content is clear but length, structure, or delivery format could change its usefulness."
        },
        {
          "id": "timeline_ambiguity",
          "label": "Timeline ambiguity",
          "subject": "a request with an unclear time frame",
          "context": "Relative dates or urgency language do not identify a dependable deadline."
        },
        {
          "id": "team_request",
          "label": "Team request",
          "subject": "an underspecified team request",
          "context": "Requester, intended user, deadline, authority, and definition of done are not fully aligned."
        },
        {
          "id": "data_request",
          "label": "Data request",
          "subject": "an ambiguous data request",
          "context": "Dataset, fields, time range, population, access rights, and output format need bounded interpretation."
        },
        {
          "id": "travel_request",
          "label": "Travel request",
          "subject": "an incomplete travel request",
          "context": "Origin, destination, dates, flexibility, travelers, and constraints determine the actual task."
        },
        {
          "id": "purchasing_request",
          "label": "Purchasing request",
          "subject": "an unclear purchasing request",
          "context": "Use case, quantity, budget, approver, delivery date, and acceptable alternatives remain partly unstated."
        }
      ],
      "intents": [
        {
          "id": "question",
          "label": "ask one decisive clarifying question",
          "goalTemplate": "Ask one decisive question that resolves the ambiguity in {subject}."
        },
        {
          "id": "restate",
          "label": "restate the understood request",
          "goalTemplate": "Restate the understood portion of {subject} for confirmation."
        },
        {
          "id": "reference",
          "label": "resolve the ambiguous reference",
          "goalTemplate": "Resolve the ambiguous reference in {subject}."
        },
        {
          "id": "assumptions",
          "label": "separate facts from assumptions",
          "goalTemplate": "Separate confirmed facts from assumptions in {subject}."
        },
        {
          "id": "bounded",
          "label": "propose a bounded interpretation",
          "goalTemplate": "Propose a bounded reversible interpretation of {subject}."
        },
        {
          "id": "confirm_scope",
          "label": "confirm the operative scope",
          "goalTemplate": "Confirm the operative scope of {subject} before proceeding."
        }
      ],
      "constraints": [
        {
          "id": "one_question",
          "label": "Ask no more than one question before offering a useful bounded step."
        },
        {
          "id": "no_guess",
          "label": "Do not silently choose an interpretation that changes the requested outcome."
        },
        {
          "id": "preserve_known",
          "label": "Preserve every part of the request that is already clear."
        },
        {
          "id": "material_only",
          "label": "Clarify only ambiguity that materially affects the result."
        },
        {
          "id": "reversible",
          "label": "Keep any provisional interpretation easy to revise."
        },
        {
          "id": "explicit_assumption",
          "label": "Label any temporary assumption explicitly."
        },
        {
          "id": "one_decisive_question",
          "label": "Ask only the question that changes the next valid action."
        },
        {
          "id": "actor_boundary",
          "label": "Keep every actor role distinct."
        }
      ],
      "states": [
        {
          "id": "multiple_meanings",
          "label": "Two interpretations are equally plausible."
        },
        {
          "id": "missing_input",
          "label": "A required input is not available."
        },
        {
          "id": "conflict",
          "label": "Two requirements point to incompatible results."
        },
        {
          "id": "mostly_clear",
          "label": "The request is mostly clear except for one material detail."
        },
        {
          "id": "safe_default",
          "label": "A narrow reversible default is available."
        },
        {
          "id": "hidden_dependency",
          "label": "The request depends on one unstated external condition."
        }
      ],
      "outcomes": [
        {
          "id": "decisive_question",
          "label": "One concise question isolates the decision that only the requester can make."
        },
        {
          "id": "confirmed_scope",
          "label": "The understood scope is restated clearly for confirmation."
        },
        {
          "id": "resolved_reference",
          "label": "The intended referent is identified without changing the request."
        },
        {
          "id": "assumption_boundary",
          "label": "Confirmed facts and temporary assumptions are visibly separated."
        },
        {
          "id": "bounded_progress",
          "label": "Useful reversible progress is possible while awaiting clarification."
        },
        {
          "id": "conflict_visible",
          "label": "The incompatible requirements and required priority choice are explicit."
        },
        {
          "id": "agreed_scope",
          "label": "The operative scope and remaining dependency are explicit."
        }
      ],
      "fallbacks": [
        {
          "id": "missing_fact",
          "label": "Request the missing fact instead of inventing a bridge sentence."
        },
        {
          "id": "pause",
          "label": "Pause before commitment and preserve the current confirmed state."
        },
        {
          "id": "smaller_scope",
          "label": "Choose a smaller reversible scope that still tests the plan."
        }
      ],
